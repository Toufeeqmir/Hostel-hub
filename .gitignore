@"
# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output
dist/
build/
coverage/

# TypeScript cache
*.tsbuildinfo

# Prisma generated client
backend/src/generated/prisma/

# Logs
*.log
npm-debug.log*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local database and backups
*.db
*.sqlite
*.sqlite3
*.dump
*.bak
"@ | Set-Content .gitignore